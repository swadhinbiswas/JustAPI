from _typeshed import Incomplete
from typing import Any

class Param:
    default: Incomplete
    alias: Incomplete
    def __init__(self, default: Any = ..., alias: str | None = None) -> None: ...

class Path(Param): ...
class Query(Param): ...
class Header(Param):
    convert_underscores: bool
    def __init__(self, default: Any = ..., alias: str | None = None, convert_underscores: bool = ...) -> None: ...
class Cookie(Param): ...
class Body(Param): ...
class File(Param): ...
class Form(Param): ...

def coerce_param_value(val: Any, annotation: Any, alias: str) -> Any: ...
