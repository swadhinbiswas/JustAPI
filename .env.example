# JustAPI Environment Configuration
# Copy this file to .env and adjust values for your deployment.

# Server
HOST=0.0.0.0
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgres://justapi:changeme@localhost:5432/justapi

# Redis (caching, rate limiting)
REDIS_URL=redis://localhost:6379

# TLS (optional)
TLS_CERT_PATH=
TLS_KEY_PATH=

# Observability
RUST_LOG=info
OTEL_SERVICE_NAME=justapi
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Static files directory (optional)
STATIC_DIR=./static

# Feature flags
COMPRESSION_ENABLED=true
