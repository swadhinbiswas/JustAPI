# ============================================================
# JustAPI — EditorConfig
# Consistent formatting across all editors and IDEs.
# https://editorconfig.org
# ============================================================

root = true

# ── Defaults ─────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ── Rust ─────────────────────────────────────────────────────
[*.rs]
indent_size = 4

# ── Python ───────────────────────────────────────────────────
[*.py]
indent_size = 4

# ── TOML (Cargo.toml, pyproject.toml, etc.) ──────────────────
[*.toml]
indent_size = 4

# ── YAML / YML (CI, Docker Compose, Helm) ────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── JSON ─────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ── Markdown ─────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# ── Protobuf ─────────────────────────────────────────────────
[*.proto]
indent_size = 2

# ── Shell scripts ────────────────────────────────────────────
[*.sh]
indent_size = 2

# ── HTML / CSS / JS ──────────────────────────────────────────
[*.{html,css,js}]
indent_size = 2

# ── Dockerfile ───────────────────────────────────────────────
[Dockerfile*]
indent_size = 4

# ── Makefiles must use tabs ──────────────────────────────────
[Makefile*]
indent_style = tab
indent_size = 4

[*.mk]
indent_style = tab
indent_size = 4
