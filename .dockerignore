# ============================================================
# JustAPI — .dockerignore
# Keep the Docker build context minimal and fast.
# ============================================================

# ── Build artifacts (huge, never needed in the image) ────────
target/
**/target/
fuzz/target/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
**/.venv/

# ── Python caches ────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/

# ── Fuzzing corpus / artifacts ───────────────────────────────
fuzz/corpus/
fuzz/artifacts/

# ── Git & CI ─────────────────────────────────────────────────
.git/
.github/

# ── Documentation & project meta ────────────────────────────
docs/
site/
skills/
*.md
!README.md

# ── Editor / OS cruft ───────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Environment / secrets (never bake into images) ──────────
.env
*.pem
*.key
*.crt

# ── Scratch / temp files at root ────────────────────────────
part1.rs
part2.rs
part3.rs
header.rs
test_gov.rs
test_upg.rs
split.py
split_native.py
split_server.py
restore.py
generate_commits.sh
protection.json

# ── Benchmark data ──────────────────────────────────────────
benchmarks/results/
benchmarks/*.json
benchmarks/*.csv

# ── Helm charts (not needed in app image) ───────────────────
helm/

# ── Deploy manifests (not needed in app image) ──────────────
deploy/

# ── Website (separate build) ────────────────────────────────
website/

# ── Test project scaffold ───────────────────────────────────
test_project/
